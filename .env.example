NODE_ENV=development
LOG_LEVEL=info
PORT=3000
WORKER_METRICS_PORT=9101

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://flash:flash@localhost:5672
DATABASE_URL=postgres://flash:flash@localhost:5432/flashsale

# Business rules
IDEMPOTENCY_TTL_SEC=86400
PER_USER_PURCHASE_LIMIT=2
MAX_QUANTITY_PER_ORDER=2

# Token-bucket defaults (override live via: HSET ratelimit:policy:global capacity 8000 refillPerSec 6000)
RL_GLOBAL_CAPACITY=6000
RL_GLOBAL_REFILL_PER_SEC=4000
RL_USER_CAPACITY=5
RL_USER_REFILL_PER_SEC=1

# Worker + circuit breaker
WORKER_PREFETCH=50
PAYMENT_TIMEOUT_MS=3000
PAYMENT_LATENCY_MS=40
PAYMENT_TRANSIENT_FAILURE_RATE=0.05
PAYMENT_DECLINE_RATE=0.02
BREAKER_ERROR_THRESHOLD_PCT=50
BREAKER_RESET_MS=10000
BREAKER_VOLUME_THRESHOLD=20
