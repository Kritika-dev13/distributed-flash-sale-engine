{
  "name": "flash-sale-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed flash-sale order processing engine (Express + Redis + RabbitMQ + PostgreSQL)",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/infra/redis/scripts','dist/infra/redis/scripts',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/workers/main.ts",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/workers/main.js",
    "prewarm": "node dist/scripts/prewarm.js"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "opossum": "^8.1.4",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "@types/opossum": "^8.1.7",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
